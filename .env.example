# Neon pooled connection string. Server-only: never prefix with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs the httpOnly session cookie. At least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-the-same-long-random-string
JWT_EXPIRES_IN=12h

# Gmail account and app password used by nodemailer.
MAIL_USER=you@gmail.com
MAIL_APP_PASSWORD=your-16-character-google-app-password

# Public origin used inside emails (set this to your deployed URL).
APP_URL=http://localhost:5173

# Database transport. Leave unset (or `pg`) for TCP port 5432. Use `neon` on
# networks that block 5432: it connects to Neon over WebSocket on port 443.
DB_DRIVER=
